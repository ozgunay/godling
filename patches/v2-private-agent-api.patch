+/// Godling SEC-001: the key /join asks for (WORLD_AGENT_KEY); None leaves joining open, as upstream.
+fn resolve_agent_key() -> Option<String> {
+    std::env::var("WORLD_AGENT_KEY")
+        .ok()
+        .map(|key| key.trim().to_string())
+        .filter(|key| !key.is_empty())
+}
+
+/// Godling SEC-001: the address the server listens on (WORLD_HOST); loopback unless told otherwise.
+fn resolve_bind_ip() -> std::net::IpAddr {
+    match std::env::var("WORLD_HOST") {
+        Ok(host) if !host.trim().is_empty() => host.trim().parse().unwrap_or_else(|_| {
+            eprintln!("Error: WORLD_HOST={host:?} is not an IP address (e.g. 127.0.0.1 or 0.0.0.0).");
+            std::process::exit(1);
+        }),
+        _ => std::net::IpAddr::from([127, 0, 0, 1]),
+    }
+}
+
+/// Compares two secrets in time that does not depend on where they first differ.
+fn constant_time_eq(a: &[u8], b: &[u8]) -> bool {
+    if a.len() != b.len() {
+        return false;
+    }
+    a.iter().zip(b).fold(0u8, |acc, (x, y)| acc | (x ^ y)) == 0
+}
