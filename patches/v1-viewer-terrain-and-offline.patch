+/// Terrain voxels in a compact form for renderers.
+#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
+pub struct SpectatorTerrain {
+    /// Changes with every terrain edit.
+    pub revision: u64,
+    pub voxel_size: f32,
+    /// Material names; `voxels` refers to them by index.
+    pub materials: Vec<String>,
+    /// Six numbers per voxel: cell x, y and z, material index, solid occupancy and liquid
+    /// occupancy (both 0-255). A cell spans `cell * voxel_size` to `(cell + 1) * voxel_size`.
+    pub voxels: Vec<i32>,
+}
+
+pub(super) fn build_spectator_terrain(terrain: &TerrainData) -> SpectatorTerrain {
+    let mut cells: Vec<(&TerrainCell, &TerrainVoxel)> = terrain.voxels.iter().collect();
+    cells.sort_unstable_by_key(|(cell, _)| (cell.x, cell.y, cell.z));
+    let mut materials: Vec<String> = Vec::new();
+    let mut voxels = Vec::with_capacity(cells.len() * 6);
+    for (cell, voxel) in cells {
+        let name = voxel.solid_material.name();
+        let index = match materials.iter().position(|m| m == name) {
+            Some(index) => index,
+            None => {
+                materials.push(name.to_string());
+                materials.len() - 1
+            }
+        };
+        voxels.extend_from_slice(&[
+            cell.x,
+            cell.y,
+            cell.z,
+            index as i32,
+            (voxel.solid_occupancy.clamp(0.0, 1.0) * 255.0).round() as i32,
+            (voxel.liquid_occupancy.clamp(0.0, 1.0) * 255.0).round() as i32,
+        ]);
+    }
+    SpectatorTerrain {
+        revision: terrain.revision,
+        voxel_size: TERRAIN_VOXEL_SIZE,
+        materials,
+        voxels,
+    }
 }
 
