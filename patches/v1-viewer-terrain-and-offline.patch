diff --git a/tests/spectator_terrain_test.rs b/tests/spectator_terrain_test.rs
new file mode 100644
index 0000000..190ff3c
--- /dev/null
+++ b/tests/spectator_terrain_test.rs
@@ -0,0 +1,88 @@
+//! Terrain reaches spectators: in full observations, and in live replication updates only when
+//! it changed.
+
+use std::collections::HashSet;
+
+use clawblox::game::instance::{GameInstance, SpectatorTerrain};
+use uuid::Uuid;
+
+fn run(instance: &GameInstance, source: &str) {
+    instance
+        .lua_runtime
+        .as_ref()
+        .expect("missing runtime")
+        .lua()
+        .load(source)
+        .exec()
+        .expect("script failed");
+}
+
+fn voxel_count(terrain: &SpectatorTerrain) -> usize {
+    terrain.voxels.len() / 6
+}
+
+#[test]
+fn full_observation_carries_terrain_only_when_there_is_some() {
+    let mut instance = GameInstance::new(Uuid::new_v4(), None);
+    instance.load_script("local _ = 1");
+    assert!(instance.get_spectator_observation().terrain.is_none());
+
+    run(
+        &instance,
+        r#"
+        workspace.Terrain:FillBlock(CFrame.new(2, 2, 2), Vector3.new(4, 4, 4), Enum.Material.Grass)
+        workspace.Terrain:FillBlock(CFrame.new(10, 2, 2), Vector3.new(4, 4, 4), Enum.Material.Water)
+        "#,
+    );
+    let terrain = instance
+        .get_spectator_observation()
+        .terrain
+        .expect("terrain should be in the full observation");
+    assert_eq!(terrain.voxel_size, 4.0);
+    assert_eq!(voxel_count(&terrain), 2);
+    let grass = terrain.materials.iter().position(|m| m == "Grass").expect("Grass material");
+    let rows: Vec<&[i32]> = terrain.voxels.chunks(6).collect();
+    assert!(
+        rows.iter().any(|v| v[0] == 0 && v[1] == 0 && v[2] == 0 && v[3] == grass as i32 && v[4] == 255),
+        "the grass voxel should be solid at cell (0, 0, 0): {rows:?}"
+    );
+    assert!(
+        rows.iter().any(|v| v[0] == 2 && v[4] == 0 && v[5] == 255),
+        "the water voxel should be liquid at cell (2, 0, 0): {rows:?}"
+    );
+}
+
+#[test]
+fn replication_update_carries_terrain_only_after_an_edit() {
+    let mut instance = GameInstance::new(Uuid::new_v4(), None);
+    instance.load_script(
+        r#"workspace.Terrain:FillBlock(CFrame.new(2, 2, 2), Vector3.new(4, 4, 4), Enum.Material.Slate)"#,
+    );
+    let base = instance.get_spectator_observation();
+    let revision = base.terrain.as_ref().expect("initial terrain").revision;
+    let known: HashSet<u32> = base.entities.iter().map(|e| e.id).collect();
+    let since = instance.replication_revision();
+
+    let quiet = instance.get_replication_observation_update(&known, since);
+    assert!(quiet.observation.terrain.is_none(), "no edit, no terrain in the update");
+
+    run(
+        &instance,
+        r#"workspace.Terrain:FillBlock(CFrame.new(2, 6, 2), Vector3.new(4, 4, 4), Enum.Material.Sand)"#,
+    );
+    let edited = instance.get_replication_observation_update(&known, since);
+    let terrain = edited.observation.terrain.expect("an edit should send the terrain");
+    assert!(terrain.revision > revision);
+    assert_eq!(voxel_count(&terrain), 2);
+
+    run(
+        &instance,
+        r#"workspace.Terrain:FillBlock(CFrame.new(2, 4, 2), Vector3.new(4, 8, 4), Enum.Material.Air)"#,
+    );
+    let cleared = instance
+        .get_replication_observation_update(&known, edited.latest_revision)
+        .observation
+        .terrain
+        .expect("clearing the terrain should send an empty terrain");
+    assert_eq!(voxel_count(&cleared), 0);
+}
