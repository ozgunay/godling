+/// Stop an agent like [`stop_agent`], then terminate every process its tmux pane had
+/// spawned. Processes that left the tmux session (`bwrap --new-session`, background jobs)
+/// would otherwise outlive the agent.
+pub fn stop_agent_and_descendants(options: AgentStopOptions) -> Result<StoppedAgent, String> {
+    let descendants = options
+        .tmux_session
+        .as_deref()
+        .map(|session| tmux_pane_descendants(session, options.tmux_window.as_deref()))
+        .unwrap_or_default();
+    let result = stop_agent(options);
+    terminate_processes(&descendants, Duration::from_secs(3));
+    result
+}
+
+fn tmux_pane_descendants(tmux_session: &str, tmux_window: Option<&str>) -> Vec<u32> {
+    let target = tmux_target(tmux_session, tmux_window);
+    let mut list_panes = Command::new("tmux");
+    list_panes.arg("list-panes");
+    if tmux_window.is_none() {
+        list_panes.arg("-s");
+    }
+    let Ok(panes) = list_panes.args(["-t", &target, "-F", "#{pane_pid}"]).output() else {
+        return Vec::new();
+    };
+    let mut stack: Vec<u32> = String::from_utf8_lossy(&panes.stdout)
+        .lines()
+        .filter_map(|line| line.trim().parse().ok())
+        .collect();
+    let Ok(ps) = Command::new("ps").args(["-A", "-o", "pid=", "-o", "ppid="]).output() else {
+        return stack;
+    };
+    let mut children: HashMap<u32, Vec<u32>> = HashMap::new();
+    for line in String::from_utf8_lossy(&ps.stdout).lines() {
+        let mut fields = line.split_whitespace().filter_map(|field| field.parse::<u32>().ok());
+        if let (Some(pid), Some(ppid)) = (fields.next(), fields.next()) {
+            children.entry(ppid).or_default().push(pid);
+        }
+    }
+    let mut found = Vec::new();
+    while let Some(pid) = stack.pop() {
+        if found.contains(&pid) {
+            continue;
+        }
+        found.push(pid);
+        if let Some(kids) = children.get(&pid) {
+            stack.extend(kids.iter().copied());
+        }
+    }
+    found.extend(sandbox_namespace_members(&found));
+    found
+}
+
+/// Processes sharing a user namespace with any of `pids` other than our own: with
+/// `--sandbox`, that is every process inside the agent's bubblewrap, orphans included.
+#[cfg(target_os = "linux")]
+fn sandbox_namespace_members(pids: &[u32]) -> Vec<u32> {
+    let user_ns = |pid: &str| std::fs::read_link(format!("/proc/{pid}/ns/user")).ok();
+    let own = user_ns("self");
+    let sandboxes: Vec<_> = pids
+        .iter()
+        .filter_map(|pid| user_ns(&pid.to_string()))
+        .filter(|ns| Some(ns) != own.as_ref())
+        .collect();
+    if sandboxes.is_empty() {
+        return Vec::new();
+    }
+    let Ok(entries) = std::fs::read_dir("/proc") else {
+        return Vec::new();
+    };
+    entries
+        .filter_map(|entry| entry.ok()?.file_name().to_str()?.parse::<u32>().ok())
+        .filter(|pid| !pids.contains(pid))
+        .filter(|pid| user_ns(&pid.to_string()).is_some_and(|ns| sandboxes.contains(&ns)))
+        .collect()
+}
+
+#[cfg(not(target_os = "linux"))]
+fn sandbox_namespace_members(_pids: &[u32]) -> Vec<u32> {
+    Vec::new()
+}
+
+#[cfg(unix)]
+fn terminate_processes(pids: &[u32], grace: Duration) {
+    let alive = |pid: u32| unsafe { libc::kill(pid as libc::pid_t, 0) == 0 };
+    for &pid in pids.iter().rev() {
+        if alive(pid) {
+            unsafe { libc::kill(pid as libc::pid_t, libc::SIGTERM) };
+        }
+    }
+    let deadline = Instant::now() + grace;
+    while Instant::now() < deadline && pids.iter().any(|&pid| alive(pid)) {
+        std::thread::sleep(Duration::from_millis(100));
+    }
+    for &pid in pids {
+        if alive(pid) {
+            unsafe { libc::kill(pid as libc::pid_t, libc::SIGKILL) };
+        }
+    }
+}
+
+#[cfg(not(unix))]
+fn terminate_processes(_pids: &[u32], _grace: Duration) {}
