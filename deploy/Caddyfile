# Godling on two origins, each with HTTPS from Let's Encrypt (Caddy does it on its own). ADR-014.
#   {$GODLING_DOMAIN}         the site: the viewer screen, accounts, credits, the admin.
#   {$GODLING_ISLAND_DOMAIN}  the world's spectator page and its stream (WORLD_BASE_PATH=/island), and only that: the
#                             agent API (join, input, observe, reset, chat, snapshot…) is never reachable from outside.
# The island is a page of its own origin inside the screen's frame, so nothing on it can reach the site's cookies or
# act as a signed-in viewer, and only the site may frame it.
# Its stream comes from the relay (ADR-015): one connection to the world, however many watch. The spectator token
# stays on the server: Caddy hands it to the world, the relay holds its own, and the public link carries none.
{$GODLING_DOMAIN} {
	encode zstd gzip
	reverse_proxy site:8000
}

{$GODLING_ISLAND_DOMAIN} {
	encode zstd gzip
	header Content-Security-Policy "frame-ancestors https://{$GODLING_DOMAIN}"
	header -X-Frame-Options
	header Referrer-Policy same-origin
	header X-Content-Type-Options nosniff

	@stream path /island/spectate/ws
	handle @stream {
		reverse_proxy relay:8082
	}
	# The page and what it fetches. Not /island/spectate: the page never asks for it, and each call would have the
	# world build the whole island.
	@island path /island /island/ /island/ui /island/ui/* /island/spectate/chat/messages /island/renderer/manifest /island/replay/info /island/renderer-files/* /island/assets/* /island/static/*
	handle @island {
		reverse_proxy island:8080 {
			header_up X-Spectator-Token {$GODLING_SPECTATOR_TOKEN}
		}
	}
	handle {
		respond 404
	}
}
