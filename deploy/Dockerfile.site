# The site (web/): accounts, credits, moderation and the viewer screen, on gunicorn; the same image runs its Celery
# worker (docker-compose.yml `worker`). Build context: the repo root.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 GODLING_DEBUG=0
WORKDIR /app/web
COPY web/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY web/ ./
COPY world/viewer/ /app/world/viewer/
# The admin's files, fingerprinted for whitenoise (a throwaway key: collectstatic signs nothing).
RUN GODLING_SECRET_KEY=collectstatic-only python manage.py collectstatic --noinput -v 0 && useradd --no-create-home site
USER site

EXPOSE 8000
# Threads (gthread): a request waiting on the database, the cache or the panel holds one of 24 threads, not one of
# 3 processes, so sign-in and Stripe's webhook always find one free (ADR-014). No request waits on the island long:
# powers go through the worker, the news is shared.
CMD ["sh", "-c", "python manage.py migrate --noinput && exec gunicorn godling_web.wsgi --bind 0.0.0.0:8000 --workers 3 --worker-class gthread --threads 8 --timeout 30 --access-logfile - --forwarded-allow-ips '*'"]
