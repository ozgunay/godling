# Copy to deploy/.env and fill in. Never commit the filled-in copy.
# Make random values with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# The domains the server answers on (DNS A/AAAA records point both at it; Caddy gets the HTTPS certificates itself).
# The site, and the island's own origin, which the site's screen shows in a frame (ADR-014).
GODLING_DOMAIN=godling.example.com
GODLING_ISLAND_DOMAIN=island.godling.example.com

# Random, long, and different from each other.
GODLING_SECRET_KEY=
GODLING_DB_PASSWORD=
GODLING_PANEL_KEY=
# Stays on the server: Caddy and the stream relay hand it to the world; the public link carries none (ADR-015).
GODLING_SPECTATOR_TOKEN=

# The mind thinks with DeepSeek.
DEEPSEEK_API_KEY=
# Extra options for mind/run_godling.py, e.g. --model deepseek-pro
GODLING_MIND_ARGS=

# Stripe (Dashboard > Developers): the secret key, and the signing secret of a webhook endpoint at
# https://<domain>/credits/stripe/webhook/ listening to checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, charge.refunded,
# charge.refund.updated (and refund.updated, refund.failed where listed), charge.dispute.created, charge.dispute.updated
# and charge.dispute.closed (refunds and disputes take credits back; deploy/README.md). Test keys (sk_test_…) first.
GODLING_STRIPE_SECRET_KEY=
GODLING_STRIPE_WEBHOOK_SECRET=
# Live keys (sk_live_…) need an outside security review first: the site will not start with them until this names it
# (who reviewed, when, where the report is). See deploy/security-review.md.
GODLING_SECURITY_REVIEW=

# Email (any SMTP provider: the confirmation emails). Port 587 with TLS, or 465 with SSL (TLS=0, SSL=1).
GODLING_FROM_EMAIL=Godling <noreply@godling.example.com>
GODLING_EMAIL_HOST=
GODLING_EMAIL_PORT=587
GODLING_EMAIL_USER=
GODLING_EMAIL_PASSWORD=
GODLING_EMAIL_TLS=1
GODLING_EMAIL_SSL=0

# Monitoring (ADR-017): where alerts go (the relay or the world down, refusals piling up, viewers falling behind,
# bandwidth, server errors, a filling disk). Sent through the SMTP above. Empty: alerts are kept, not sent.
GODLING_ALERT_EMAIL=

# Cloudflare in front (ADR-017, deploy/README.md). Its address ranges, space-separated, from
# https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6: Caddy then believes the viewer's address
# Cloudflare forwards, and only from Cloudflare. Empty when Cloudflare is not in front.
GODLING_PROXY_RANGES=
# Turnstile on sign-up (Cloudflare dashboard > Turnstile, a widget for the site's domain): a check that a person, not
# a script, signs up. Both empty: off.
GODLING_TURNSTILE_SITE_KEY=
GODLING_TURNSTILE_SECRET_KEY=
# Replays (ADR-016). The island packs its recordings into small chunks (about 0.2 GB a day) and keeps the raw
# recordings (about 5 GB a day) this many days, for debugging:
GODLING_REPLAY_RAW_DAYS=3
# To keep the chunks in object storage too, an S3-compatible bucket with public reads. Cloudflare R2 (recommended:
# no charge for downloads): endpoint https://<account id>.r2.cloudflarestorage.com, region auto, and the bucket's
# public r2.dev or custom-domain address. Hetzner: https://<location>.your-objectstorage.com. The island's page fetches
# them from another origin, so the bucket needs a CORS rule (GET and HEAD from any origin): the packer sets one at its
# start, and says in replay.log if its key may not (then set it in the bucket's settings). Chunks go to the bucket in
# the background; until each is up, browsers fetch it from the island. Empty: chunks stay in the runs volume, and
# Caddy serves them on the island's origin at /replay.
GODLING_REPLAY_BUCKET=
GODLING_REPLAY_ENDPOINT=
GODLING_REPLAY_KEY_ID=
GODLING_REPLAY_SECRET=
GODLING_REPLAY_PUBLIC_URL=
GODLING_REPLAY_PREFIX=island
GODLING_REPLAY_REGION=auto

# Backups (ADR-018, deploy/README.md): the database every hour and the run every six hours (Godling's memory, the
# island's save, the replays), as encrypted restic snapshots. Long and random. Keep it in a password manager as well:
# without it no backup can be read.
GODLING_BACKUP_PASSWORD=
# Where they go: a private bucket of their own (not the replays' public one). Cloudflare R2 (recommended: the first
# 10 GB are free, and restores cost nothing): s3:https://<account id>.r2.cloudflarestorage.com/<bucket>, region auto,
# with an R2 API token's key id and secret that may read and write that bucket. Hetzner:
# s3:https://<location>.your-objectstorage.com/<bucket>. Empty: a volume on this server, which does not survive losing
# the server (an alert says so until a bucket is set).
GODLING_BACKUP_REPOSITORY=
GODLING_BACKUP_KEY_ID=
GODLING_BACKUP_SECRET=
GODLING_BACKUP_REGION=auto

# Test mode, welcome credits, pace, note length and reports are the site rules, in the admin (Site rules).
