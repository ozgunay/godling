# Copy to deploy/.env and fill in. Never commit the filled-in copy.
# Make random values with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# The domains the server answers on (DNS A/AAAA records point both at it; Caddy gets the HTTPS certificates itself).
# The site, and the island's own origin, which the site's screen shows in a frame (ADR-014).
GODLING_DOMAIN=godling.example.com
GODLING_ISLAND_DOMAIN=island.godling.example.com

# Random, long, and different from each other.
GODLING_SECRET_KEY=
GODLING_DB_PASSWORD=
GODLING_PANEL_KEY=
# Stays on the server: Caddy and the stream relay hand it to the world; the public link carries none (ADR-015).
GODLING_SPECTATOR_TOKEN=

# The mind thinks with DeepSeek.
DEEPSEEK_API_KEY=
# Extra options for mind/run_godling.py, e.g. --model deepseek-pro
GODLING_MIND_ARGS=

# Stripe (Dashboard > Developers): the secret key, and the signing secret of a webhook endpoint at
# https://<domain>/credits/stripe/webhook/ listening to checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, charge.refunded,
# charge.dispute.created and charge.dispute.closed (refunds and disputes take credits back). Test keys (sk_test_…)
# first.
GODLING_STRIPE_SECRET_KEY=
GODLING_STRIPE_WEBHOOK_SECRET=
# Live keys (sk_live_…) need an outside security review first: the site will not start with them until this names it
# (who reviewed, when, where the report is). See deploy/security-review.md.
GODLING_SECURITY_REVIEW=

# Email (any SMTP provider: the confirmation emails). Port 587 with TLS, or 465 with SSL (TLS=0, SSL=1).
GODLING_FROM_EMAIL=Godling <noreply@godling.example.com>
GODLING_EMAIL_HOST=
GODLING_EMAIL_PORT=587
GODLING_EMAIL_USER=
GODLING_EMAIL_PASSWORD=
GODLING_EMAIL_TLS=1
GODLING_EMAIL_SSL=0

# Monitoring (ADR-016): where alerts go (the relay or the world down, refusals piling up, viewers falling behind,
# bandwidth, server errors, a filling disk). Sent through the SMTP above. Empty: alerts are kept, not sent.
GODLING_ALERT_EMAIL=

# Cloudflare in front (ADR-016, deploy/README.md). Its address ranges, space-separated, from
# https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6: Caddy then believes the viewer's address
# Cloudflare forwards, and only from Cloudflare. Empty when Cloudflare is not in front.
GODLING_PROXY_RANGES=
# Turnstile on sign-up (Cloudflare dashboard > Turnstile, a widget for the site's domain): a check that a person, not
# a script, signs up. Both empty: off.
GODLING_TURNSTILE_SITE_KEY=
GODLING_TURNSTILE_SECRET_KEY=

# Test mode, welcome credits, pace, note length and reports are the site rules, in the admin (Site rules).
